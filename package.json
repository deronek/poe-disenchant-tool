{
  "name": "poe-disenchant-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "scan": "pnpx react-scan@latest localhost:3000",
    "prebuild": "tsx scripts/validate-dust-data.ts",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "prettier --check . && eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "test:unit": "vitest --config vitest.config.mts",
    "test:unit:ui": "vitest --config vitest.jsdom.config.mts",
    "test:ui": "playwright test --ui",
    "test:desktop": "playwright test tests/desktop",
    "test:mobile": "playwright test tests/mobile",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:update": "playwright test --update-snapshots",
    "test:install": "playwright install --with-deps",
    "test:vrt": "playwright test --project=vrt-light --project=vrt-dark",
    "test:vrt:ui": "playwright test --ui --project=vrt-light --project=vrt-dark",
    "test:vrt:update": "playwright test --project=vrt-light --project=vrt-dark --update-snapshots",
    "dust:process": "tsx scripts/process-dust-data.ts && tsx scripts/validate-dust-data.ts",
    "dust:validate": "tsx scripts/validate-dust-data.ts",
    "populate-devdata": "tsx scripts/populate-devdata.ts"
  },
  "dependencies": {
    "@axiomhq/js": "^1.6.0",
    "@axiomhq/logging": "^0.2.0",
    "@axiomhq/nextjs": "^0.2.0",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-store": "^0.11.1",
    "@tanstack/react-table": "^9.1.2",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "16.0.7",
    "next-themes": "^0.4.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-scan": "^0.4.3",
    "serialize-error": "^13.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@next/eslint-plugin-next": "16.0.0",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.1.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^5.0.2",
    "@welldone-software/why-did-you-render": "^10.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "csv-parse": "^5.6.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.13",
    "tailwindcss": "^4.1.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2"
    },
    "onlyBuiltDependencies": [
      "@vercel/speed-insights"
    ]
  }
}
